# Wayra environment template (PRD 01 F-03).
# Committed. The real files (.env.staging, .env.uat, .env.production) are git-ignored
# and created from this one with: npm run env:init
#
# Values are compiled into the app binary and are readable by anyone who has it.
# Never put secrets here. No secrets exist yet.

# Which environment this build belongs to: staging | uat | production
APP_ENV=staging
